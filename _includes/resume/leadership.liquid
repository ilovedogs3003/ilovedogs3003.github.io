<div class="list-groups">
  {% assign entries = data[1] %}
  {% for content in entries %}
    <div class="list-group col-md-6">
      <table class="table-cv list-group-table">
        <tbody>
          <tr>
            <td class="list-group-category" colspan="2">
              {{ content.organization }}
            </td>
          </tr>
          <tr>
            <td></td>
            <td class="list-group-name">
              <b>{{ content.position }}</b><br>
              <small>
                {{ content.startDate | date: "%b %Y" }} – 
                {{ content.endDate | date: "%b %Y" }}
              </small>
              {% if content.summary %}
                <p class="mt-1">{{ content.summary }}</p>
              {% endif %}
              {% if content.highlights %}
                <ul class="mt-1">
                  {% for point in content.highlights %}
                    <li>{{ point }}</li>
                  {% endfor %}
                </ul>
              {% endif %}
              {% if content.url %}
                <a href="{{ content.url }}" target="_blank" class="btn btn-sm btn-outline-secondary mt-2">
                  View More
                </a>
              {% endif %}
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  {% endfor %}
</div>



