{% assign entries = data[1] | sort: 'startDate' | reverse %}
{% for content in entries %}
  <div class="item mb-3">
    <h6 class="mb-1"><strong>{{ content.studyType }}</strong></h6>

    <div class="d-flex justify-content-between align-items-center mb-1">
      <span class="text-muted" style="white-space: nowrap;">
        {{ content.institution }}
      </span>
      <span class="text-muted" style="white-space: nowrap;">
        {{ content.startDate | date: "%b %Y" }} – {{ content.endDate | date: "%b %Y" }}
      </span>
    </div>

    {% if content.area %}
      <p class="mb-1"><em>{{ content.area }}</em></p>
    {% endif %}

    {% if content.courses %}
      <ul class="mb-2">
        {% for course in content.courses %}
          <li>{{ course }}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
{% endfor %}

