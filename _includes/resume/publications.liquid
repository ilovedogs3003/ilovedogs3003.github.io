{% assign publications = data[1] | sort: 'releaseDate' | reverse %}
{% for content in publications %}
  <div class="item mb-3">
    <h6 class="mb-1 font-weight-bold">
      {% if content.url %}
        <a href="{{ content.url }}">{{ content.name }}</a>
      {% else %}
        {{ content.name }}
      {% endif %}
    </h6>

    <div class="d-flex justify-content-between align-items-center mb-1">
      <span class="text-muted" style="white-space: nowrap;">
        {{ content.publisher }}
      </span>
      <span class="text-muted" style="white-space: nowrap;">
        {{ content.releaseDate | date: "%b %Y" }}
      </span>
    </div>

    {% if content.summary %}
      <p class="mb-1">{{ content.summary }}</p>
    {% endif %}
  </div>
{% endfor %}

