{% assign work = data[1] | sort: 'startDate' | reverse %}
{% for content in work %}
  <div class="item mb-3">
    <h6 class="mb-1 font-weight-bold">
      {% if content.url %}
        <a href="{{ content.url }}">{{ content.position }}</a>
      {% else %}
        {{ content.position }}
      {% endif %}
    </h6>

    <div class="d-flex justify-content-between align-items-center mb-1">
      <span class="text-muted" style="white-space: nowrap;">
        {{ content.name }}
      </span>
      <span class="text-muted" style="white-space: nowrap;">
        {{ content.startDate | date: "%b %Y" }} – {{ content.endDate | date: "%b %Y" }}
      </span>
    </div>

    {% if content.summary %}
      <p class="mb-1">{{ content.summary }}</p>
    {% endif %}

    {% if content.highlights %}
      <ul class="mb-2">
        {% for item in content.highlights %}
          <li>{{ item }}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
{% endfor %}

